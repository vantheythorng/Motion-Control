<?xml version="1.0" encoding="utf-8"?>
<!-- Backup rules for Android 12+. -->
<data-extraction-rules>
    <!-- Whether the Quick Settings tile is added belongs to this phone, not a restored one. -->
    <cloud-backup>
        <exclude domain="sharedpref" path="tile_status.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="tile_status.xml" />
    </device-transfer>
</data-extraction-rules>
